cff-version: 1.2.0
message: >-
  If you use GEM or its miner, please cite the MSR Data and Tool
  Showcase paper once it is published, and the archived release you
  actually used: the dataset is 10.5281/zenodo.22264777 and the miner
  10.5281/zenodo.22264638.
title: "GEM: A Dataset of Engine Version Migrations in Open-Source Game Projects"
abstract: >-
  Engine version state and migration events mined from open-source game
  projects. A frame of 39,553 non-fork GitHub repositories created
  before Godot 4.0, 5,988 probed for their declared engine version and
  300 mined commit by commit into 1,134 version events, 131 major
  migrations, 135 migration windows, and pre- and post-migration trees
  for 103 repositories. Survival records are reported under two
  reference versions rather than one, and every row cites the
  content-addressed artifact it was computed from.
type: dataset
version: 0.1.0
date-released: "2026-08-26"
doi: 10.5281/zenodo.22264777

# Taken from the repository's git identity. Add an ORCID, and add the
# co-author once authorship is agreed -- the paper carries two author
# slots and this file currently carries one.
authors:
  - family-names: "Pires"
    given-names: "Gabriel"
    affiliation: "COPPE/UFRJ"
    # orcid: "https://orcid.org/0000-0000-0000-0000"

license: CC-BY-4.0
license-url: "https://creativecommons.org/licenses/by/4.0/legalcode"
repository-code: "https://github.com/gabrielpires01/game-engine-migration-miner"
keywords:
  - mining software repositories
  - dataset
  - game engines
  - breaking changes
  - software migration
  - technical lag
  - Godot

references:
  - type: software
    title: "GEM miner"
    abstract: >-
      The pipeline that builds GEM: release timeline, corpus frame,
      version snapshots, instrument validation, per-commit history
      mining, demand collection, and derivations.
    license: Apache-2.0
    version: 0.1.1
    doi: 10.5281/zenodo.22264638
    authors:
      - family-names: "Pires"
        given-names: "Gabriel"
